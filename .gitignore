###########################################
## Added to .gitignore

# Solution build directory and language-specific build directories
/bin
/bin-*


# Lazy method of hiding work-in-progress or local-only files with common extensions
_wip/
_unused/


###########################################
## Visual Studio IDE

/.vs
*.vcxproj.filters
*.vcxproj.user
*.aps
*.pdb


###########################################
## Original .gitignore

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
#*.exe
*.out
*.app


###########################################
## Explicit includes

# Nothing in here
/lib/unused/**

# Everything in here (d3drm.lib, d3drm.def, inc/*)
!/lib/d3drm/*.def
!/lib/d3drm/*.lib

# Patched launchers: these are the ORIGINAL game executable with an import appended.
# They are copyrighted game code and must never be committed. Generate your own with
# OpenLRR-MakeExe from your own legally obtained LegoRR.exe.
/OpenLRR.exe
/OpenLRR-d.exe

# Harness build output
/bin/harness.exe
/bin/harness.pdb

# Secrets: never commit an API key. tools/audio/generate.py reads ELEVENLABS_API_KEY
# from the environment and writes it nowhere.
.env
*.key
secrets.json

# API keys never belong in this repository. tools/gen/genimage.py reads TOGETHER_API_KEY from
# the environment, or a file pointed at by TOGETHER_KEY_FILE that lives outside the tree.
*.key
together.key
.env

# IDE project files. workspace.xml in particular is per-machine window state and
# churns on every session.
/.idea/

# Python bytecode from tools/
__pycache__/
*.pyc
